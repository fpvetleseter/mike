# ============================================================
# Juridisk Backend — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# SECRETS: these values must NEVER appear in frontend code,
# NEVER have NEXT_PUBLIC_ prefix, NEVER be logged in production.
# ============================================================

# Anthropic — SECURITY: backend only, never frontend
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-7

# OpenAI — SECURITY: backend only (used for embeddings)
OPENAI_API_KEY=sk-your-key-here

# Supabase — SECURITY: service role key is a secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 — SECURITY: backend only
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=juridisk-documents
CLOUDFLARE_R2_ENDPOINT=https://79a4bc1dce5114ee00a16a215e658a91.r2.cloudflarestorage.com

# Stripe — SECURITY: backend only
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Lovdata Pro API — SECURITY: backend only
LOVDATA_API_KEY=your-lovdata-key-here

# App config
NODE_ENV=development
PORT=3001
# Required on Railway: exact frontend origin (Vercel URL), no trailing slash
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_FREE_DAILY=10
RATE_LIMIT_FREE_MONTHLY_DOCS=3
