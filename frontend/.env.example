# ============================================================
# Juridisk Frontend — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase — safe to expose (anon key is designed to be public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend URL — full Railway URL, no trailing slash, required for all backend calls
# Example: https://juridisk-backend-production.up.railway.app
NEXT_PUBLIC_BACKEND_URL=https://your-backend.railway.app
